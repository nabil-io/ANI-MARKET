# Interdiction d'execution de scripts dans le dossier uploads
<FilesMatch "\.(php|php[0-9]|phtml|pl|py|cgi|sh|bash)$">
    Require all denied
</FilesMatch>
Options -ExecCGI
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>
